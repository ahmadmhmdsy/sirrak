# Normalise line endings; Windows build scripts stay CRLF, everything else LF.
* text=auto eol=lf
*.bat text eol=crlf
gradlew.bat text eol=crlf
*.ps1 text eol=crlf
*.sh text eol=lf
gradlew text eol=lf

# Binaries are never diffed or converted
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.jar binary
*.aar binary
*.so binary
*.gguf binary
*.jks binary
*.keystore binary
