<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- M10 dictation: audio is captured locally and transcribed on device; nothing is uploaded. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- M11 model downloads: the ONLY network use in the app. A catalogue model is fetched from its
         Hugging Face URL into app-private storage; no telemetry, no analytics, no other request. The
         user can always import a GGUF through SAF instead, which needs no network at all. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- P3.4 background downloads: while a model download runs, a dataSync foreground service keeps
         the process alive so leaving the app does not pause the transfer. The notification is the
         only UI it adds; it shows progress and a cancel action. POST_NOTIFICATIONS is optional: if it
         is denied the service still runs and the transfer still completes (Android then hides the
         notification from the shade and shows it in the task manager instead). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".SirrakApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sirrak">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- P3.4: consulted by ModelDownloader's activity seam; stops itself on any terminal state. -->
        <service
            android:name=".DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- M9: hands the camera app a one-shot writable Uri for a capture; no storage permission. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
